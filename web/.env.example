# Copie este arquivo para .env.local e preencha.
# Só a chave PÚBLICA (anon ou publishable) vai aqui. Nunca a chave de serviço (service_role / secret).
#
# Supabase local: rode `npx supabase status` na raiz e copie API_URL e ANON_KEY.
# Supabase na nuvem: painel do projeto > Project Settings > API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-publica
